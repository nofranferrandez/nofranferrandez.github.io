---
import { getCollection } from "astro:content";
import SEO from "../components/SEO.astro";
import FAQSection from "../components/FAQSection.astro";
import AdSlot from "../components/AdSlot.astro";
import Cards from "../components/Cards.astro";
import HomeBenefits from "../components/HomeBenefits.astro";
import PageIntro from "../components/PageIntro.astro";
import { cardDetails, homeFaqs } from "../data/homeContent";

const calculators = await getCollection("calculators");
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="CALCULA | Calculadoras Fiscales y Laborales en España"
      description="Calculadoras gratuitas de IRPF, sueldo neto y pensión para tus decisiones fiscales y laborales en España."
      category="UtilitiesApplication"
      keywords={[
        "calculadoras fiscales",
        "calculadora IRPF",
        "calculadora pensión",
      ]}
      faqs={homeFaqs}
    />
    {
      import.meta.env.PUBLIC_ADSENSE_CLIENT && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`}
          crossorigin="anonymous"
        />
      )
    }
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-slate-50 font-sans text-slate-800">
    <header class="border-b border-slate-200 bg-white">
      <nav
        class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4"
        aria-label="Navegación principal"
      >
        <a href="/" class="text-xl font-extrabold tracking-tight text-slate-900"
          >CALCULA<span class="text-blue-600">.ES</span></a
        >
        <span
          class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700"
          >Actualizado 2026</span
        >
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
      <section
        class="grid items-center gap-10 lg:grid-cols-[1fr_320px]"
        aria-labelledby="page-title"
      >
        <div>
          <PageIntro
            id="page-title"
            eyebrow="Decisiones más claras"
            title="Calculadoras fiscales y laborales para España"
            description="Calcula tu IRPF, sueldo neto y pensión de jubilación con herramientas gratuitas, rápidas y fáciles de entender."
            theme="blue"
          />
          <a
            href="#calculadoras"
            class="mt-7 inline-flex min-h-11 items-center rounded-lg bg-blue-600 px-5 py-3 font-bold text-white shadow-sm hover:bg-blue-700"
            >Ver calculadoras</a
          >
        </div>
        <aside
          class="rounded-3xl border border-blue-100 bg-blue-50 p-6 shadow-sm"
          aria-label="Ventajas de las calculadoras"
        >
          <p
            class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700"
          >
            Tu información, bajo control
          </p>
          <h2 class="mt-3 text-2xl font-black tracking-tight text-slate-900">
            Hechas para resolverlo rápido
          </h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            Una experiencia sencilla para pasar de la duda a una estimación útil
            en pocos pasos.
          </p>
        </aside>
      </section>

      <AdSlot slot="home-top" format="horizontal" label="Publicidad superior" />
      <HomeBenefits />
      <Cards calculators={calculators} cardDetails={cardDetails} />

      <AdSlot
        slot="home-middle"
        format="rectangle"
        label="Publicidad entre contenidos"
      />

      <section class="mt-12 max-w-3xl" aria-labelledby="guide-title">
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-slate-500">
          Guía rápida
        </p>
        <h2 id="guide-title" class="mt-2 text-3xl font-black text-slate-900">
          ¿Qué calculadora necesitas?
        </h2>
        <div class="mt-5 space-y-4 text-base leading-7 text-slate-600">
          <p>
            Si quieres saber cuánto cobrarás después de impuestos, empieza por
            la calculadora de IRPF y sueldo neto. Si estás planificando tu
            retiro, la calculadora de pensión relaciona tus años cotizados con
            una estimación mensual.
          </p>
          <p>
            Los resultados son orientativos y sirven para preparar una
            conversación con tu empresa, la administración o un asesor.
            Comprueba siempre los datos oficiales antes de tomar decisiones
            económicas.
          </p>
        </div>
      </section>

      <FAQSection faqs={homeFaqs} />
      <AdSlot
        slot="home-bottom"
        format="horizontal"
        label="Publicidad inferior"
      />
    </main>

    <footer
      class="border-t border-slate-200 bg-white px-4 py-8 text-center text-sm text-slate-500"
    >
      <p>© 2026 CALCULA.ES · Estimaciones informativas para España</p>
    </footer>
  </body>
</html>
