---
import type { CollectionEntry } from 'astro:content';
import type { CardDetail } from '../data/homeContent';

type Calculator = CollectionEntry<'calculators'>;

interface Props {
  calculators: Calculator[];
  cardDetails: Record<string, CardDetail>;
}

const { calculators, cardDetails } = Astro.props as Props;
---

<section id="calculadoras" class="scroll-mt-8 pt-10" aria-labelledby="calculators-title">
  <div class="mb-6 flex items-end justify-between gap-4">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-slate-500">Herramientas disponibles</p>
      <h2 id="calculators-title" class="mt-2 text-3xl font-black text-slate-900">Calcula con datos sencillos</h2>
    </div>
    <span class="hidden text-sm text-slate-500 sm:block">{calculators.length} herramientas</span>
  </div>

  <div class="mb-6 w-full">
    <label for="calculator-search" class="mb-2 block text-sm font-bold text-slate-700">¿Qué necesitas calcular?</label>
    <div class="relative">
      <span class="pointer-events-none absolute inset-y-0 left-0 flex w-11 items-center justify-center text-lg leading-none text-slate-400" aria-hidden="true">⌕</span>
      <input id="calculator-search" type="search" placeholder="Busca IRPF, paro, coche, vivienda..." class="w-full rounded-xl border border-slate-300 bg-white py-3.5 pl-11 pr-4 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
    </div>
    <p id="search-status" class="mt-2 text-xs text-slate-500" aria-live="polite">Mostrando {calculators.length} calculadoras</p>
  </div>

  <div class="grid gap-5 md:grid-cols-2" aria-label="Calculadoras disponibles">
    {calculators.map((calculator) => {
      const slug = calculator.id.replace(/\.md$/, '');
      const details = cardDetails[slug];

      if (!details) return null;

      return (
        <a
          href={`/${slug}/`}
          data-calculator-card
          data-search={`${details.shortTitle} ${details.eyebrow} ${details.outcome} ${calculator.data.title} ${calculator.data.description} ${calculator.data.keywords.join(' ')}`}
          class={`group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 ${details.hoverClass} hover:shadow-lg`}
        >
          <div class={`absolute right-0 top-0 h-24 w-24 rounded-bl-full ${details.blobClass} transition group-hover:scale-125`} aria-hidden="true"></div>
          <div class="relative flex items-start justify-between gap-4">
            <div class={`flex h-12 w-12 items-center justify-center rounded-2xl text-xl font-black ${details.iconClass}`} aria-hidden="true">{details.icon}</div>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-500">2026</span>
          </div>
          <p class={`relative mt-5 text-xs font-bold uppercase tracking-[0.12em] ${details.eyebrowClass}`}>{details.eyebrow}</p>
          <h3 class="relative mt-2 text-xl font-black tracking-tight text-slate-900 group-hover:text-blue-700">{details.shortTitle}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">{calculator.data.description}</p>
          <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
            <span class="text-sm font-bold text-slate-900">
              {details.action}
              <span aria-hidden="true" class="text-blue-600">→</span>
            </span>
            <span class="rounded-lg bg-slate-50 px-2.5 py-1.5 text-[11px] font-semibold text-slate-500">{details.outcome}</span>
          </div>
        </a>
      );
    })}
  </div>

  <p id="search-empty" class="mt-6 hidden rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
    No hemos encontrado una calculadora con ese término. Prueba con “nómina”, “casa” o “despido”.
  </p>
</section>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#calculator-search');
  const searchStatus = document.querySelector<HTMLElement>('#search-status');
  const emptyState = document.querySelector<HTMLElement>('#search-empty');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-calculator-card]'));

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLocaleLowerCase('es-ES');
    let visibleCount = 0;

    cards.forEach((card) => {
      const matches = card.dataset.search?.toLocaleLowerCase('es-ES').includes(query) ?? false;
      card.classList.toggle('hidden', !matches);

      if (matches) visibleCount += 1;
    });

    if (searchStatus) {
      searchStatus.textContent = query
        ? `${visibleCount} resultado${visibleCount === 1 ? '' : 's'} encontrado${visibleCount === 1 ? '' : 's'}`
        : `Mostrando ${cards.length} calculadoras`;
    }

    emptyState?.classList.toggle('hidden', visibleCount > 0);
  });
</script>
