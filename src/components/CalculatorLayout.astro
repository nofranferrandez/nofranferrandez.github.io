---
import SEO from './SEO.astro';
import type { CollectionEntry } from 'astro:content';

type Calculator = CollectionEntry<'calculators'>;
interface Props {
  calculator: Calculator;
  slug: string;
}
const { calculator, slug } = Astro.props;
const { title, description, category, keywords, faqs } = calculator.data;
---
<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} category={category} keywords={keywords} faqs={faqs} slug={slug} />
    {import.meta.env.PUBLIC_ADSENSE_CLIENT && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`} crossorigin="anonymous"></script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
        <a href="/" class="font-extrabold tracking-tight text-slate-900">CALCULA<span class="text-blue-600">.ES</span></a>
        <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">Leyes 2026</span>
      </div>
    </header>
    <main class="mx-auto w-full max-w-5xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white px-4 py-8 text-center text-sm text-slate-500">
      <p>© 2026 CALCULA.ES · Estimaciones informativas para España</p>
      <p class="mt-2 text-xs text-slate-400">Los resultados son orientativos y no sustituyen asesoramiento profesional.</p>
    </footer>
  </body>
</html>
