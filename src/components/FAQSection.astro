---
interface Faq {
  question: string;
  answer: string;
}
const { faqs } = Astro.props as { faqs: Faq[] };
---
<section class="mt-8" aria-labelledby="faq-title">
  <div class="mb-5 flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700">Resolvemos tus dudas</p>
      <h2 id="faq-title" class="mt-2 text-2xl font-black tracking-tight text-slate-900">Preguntas frecuentes</h2>
    </div>
    <span class="hidden rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500 sm:block">Información útil</span>
  </div>
  <div class="space-y-3">
    {faqs.map((faq, index) => (
      <details class="group rounded-2xl border border-slate-200 bg-white shadow-sm open:border-blue-200 open:shadow-md" open={index === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-bold text-slate-900 [&::-webkit-details-marker]:hidden">
          <span>{faq.question}</span>
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-50 text-lg font-normal text-blue-700 transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <div class="border-t border-slate-100 px-5 pb-5 pt-4">
          <p class="max-w-3xl text-sm leading-7 text-slate-600">{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  details[open] > div {
    animation: faq-open 220ms ease-out;
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details[open] > div {
      animation: none;
    }
  }
</style>
