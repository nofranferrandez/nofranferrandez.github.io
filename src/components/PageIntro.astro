---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  theme?: "blue" | "emerald" | "amber" | "violet" | "rose" | "slate";
  id?: string;
}

const {
  eyebrow,
  title,
  description,
  theme = "blue",
  id = "page-title",
} = Astro.props as Props;

const palette = {
  blue: {
    eyebrow: "text-blue-600",
    title: "text-slate-900",
    description: "text-slate-600",
  },
  emerald: {
    eyebrow: "text-emerald-700",
    title: "text-slate-900",
    description: "text-slate-600",
  },
  amber: {
    eyebrow: "text-amber-700",
    title: "text-slate-900",
    description: "text-slate-600",
  },
  violet: {
    eyebrow: "text-violet-700",
    title: "text-slate-900",
    description: "text-slate-600",
  },
  rose: {
    eyebrow: "text-rose-700",
    title: "text-slate-900",
    description: "text-slate-600",
  },
  slate: {
    eyebrow: "text-slate-700",
    title: "text-slate-900",
    description: "text-slate-600",
  },
};

const styles = palette[theme];
---

<div>
  {
    eyebrow && (
      <p
        class={`mb-4 text-sm font-bold uppercase tracking-[0.18em] ${styles.eyebrow}`}
      >
        {eyebrow}
      </p>
    )
  }
  <h1
    id={id}
    class={`max-w-3xl text-4xl font-black tracking-tight ${styles.title} sm:text-6xl`}
  >
    {title}
  </h1>
  <p class={`mt-5 max-w-2xl text-lg leading-8 ${styles.description}`}>
    {description}
  </p>
</div>
